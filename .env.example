# ============================================================
# 小树成长岛 (studentStudy) 部署配置
# 服务器上由 Jenkins 部署时自动从本文件生成 .env
# 本地开发直接 docker compose 时无需配置（自动取默认值）
# ============================================================

# 代码目录：服务器部署时 Jenkins 将仓库克隆到 $DEPLOY_PATH/src
# 因此设置为 ./src；本地在仓库根目录运行时保持为空即可（默认 .）
SRC_DIR=./src

# 对外访问端口（nginx 映射到宿主机）
NGINX_PORT=8061

# 后端端口（仅监听 127.0.0.1，用于本机调试，不对外）
BACKEND_PORT=3001

# ===== 安全配置 =====
# JWT 密钥：留空即可 —— 后端首次启动会自动生成随机密钥，
# 并写入数据卷 /app/data/.jwt_secret 长期复用（重启/升级都不会失效）。
# 如需显式指定，请填 32 位以上随机串（例如 `openssl rand -hex 32` 的输出）；
# 切勿使用示例值或任何写在仓库里的字符串。
JWT_SECRET=

# 注册策略：首个家长账号可自由注册；之后新增家长必须提供该邀请码。
# 留空表示「已有家长账号后禁止再注册」（家庭私有应用的推荐设置）。
REGISTER_INVITE_CODE=

# 跨域白名单（逗号分隔）。同源部署（nginx 同时提供页面和 /api）无需修改。
# 用 Capacitor 安卓壳直连后端时需要保留 capacitor://localhost 与 http://localhost。
CORS_ORIGINS=http://localhost,http://127.0.0.1,capacitor://localhost

# 是否开启 FastAPI 接口文档（/docs、/redoc、/openapi.json）。生产建议保持 false。
ENABLE_API_DOCS=false

# 上传图片大小上限（MB）
MAX_UPLOAD_MB=8

# ===== LLM 配置（可选，用于 AI 错题分析 / 成长评估报告） =====
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 是否允许 LLM endpoint 指向内网地址（仅自建局域网模型时设为 true）
LLM_ALLOW_PRIVATE_ENDPOINT=false
